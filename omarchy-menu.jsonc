{
  // Merge into ~/.config/omarchy/extensions/omarchy-menu.jsonc
  "style.grid-wallpaper-picker": {
    "icon": "󰔉",
    "label": "Grid wallpaper picker",
    "aliases": ["hex", "honeycomb", "gallery", "wallpaper"]
  },
  "style.grid-wallpaper-picker.themes": {
    "icon": "󰸌",
    "label": "Themes",
    "action": "omarchy-shell shell summon rblalock.grid-wallpaper-picker '{\"mode\":\"themes\"}'"
  },
  "style.grid-wallpaper-picker.backgrounds": {
    "icon": "",
    "label": "Backgrounds",
    "action": "omarchy-shell shell summon rblalock.grid-wallpaper-picker '{\"mode\":\"backgrounds\"}'"
  },
  "style.grid-wallpaper-picker.gallery": {
    "icon": "󰋩",
    "label": "Gallery",
    "action": "omarchy-shell shell summon rblalock.grid-wallpaper-picker '{\"mode\":\"gallery\"}'"
  }
}
